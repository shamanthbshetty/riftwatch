# TMDB API key — movie/TV details, search, streams metadata (movies tab).
TMDB_API_KEY=

# VidSrc signing key — embedded movie/TV playback (referenced by
# src/lib/movie-providers.ts). Leave empty to skip that provider.
VIDLINK_KEY=

# --- Upstream domain rotation (the fix for "404s every 1-2 weeks") ---
# Every provider scrapes an unofficial mirror whose domain dies regularly.
# When a domain dies, add/replace it here and restart — no source edit needed.
# All lists are comma-separated. A single dead domain never fails the request
# as long as one entry in the list is alive (checked live via /api/health).

# HiAnime clone (was single hardcoded https://aniwatch.co.at).
ANIWATCH_BASES=https://aniwatch.co.at

# Anikoto WordPress mirrors. Format per entry: https://host|Label (label optional).
ANIKOTO_MIRRORS=https://anikoto.cz|Anikoto CZ,https://anikototv.to|Anikoto,https://anikoto.me|Anikoto ME,https://anikoto.net|Anikoto NET

# Kenjitsu Vercel deployment(s). KENJITSU_BASE is accepted as a singular alias.
KENJITSU_BASES=https://kenjitsu.vercel.app

# AllAnime frontend mirror page + backend api host (backend is api.<host>).
# Previously hardcoded to mkissa.to / mkissa.net.
ALLANIME_MIRROR=mkissa.to
ALLANIME_BACKEND=mkissa.net
# Comma-separated fallback backends, each "page|backend" or a full api URL.
# e.g. ALLANIME_FALLBACK_MIRRORS=allanime.day|api.allanime.day
ALLANIME_FALLBACK_MIRRORS=
# Optional egress wrapper for AllAnime API calls (two fetch-compatible modes):
#   template:  ALLANIME_PROXY=https://host/?url=$URL
#   prefix:    ALLANIME_PROXY=https://host
# (CONNECT tunnels like http://user:pass@host:port need an agent — ignored with a warning.)
ALLANIME_PROXY=

# VidSrc embed domains (one player button per domain).
VIDSRC_DOMAINS=https://vidsrc.sh,https://vidsrc2.ru,https://vidsrc.ir,https://vsembed.su

# Rust proxy service (Phase 1). Leave empty to use the built-in Node proxies.
RUST_PROXY_URL=http://localhost:3001
