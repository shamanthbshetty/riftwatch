# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust build artifacts
/rust-backend/target/
/native-app/target/

# tauri build artifacts
/src-tauri/target/
/src-tauri/gen/
/src-tauri/binaries/
/out/

# tauri updater signing keys (never commit private keys or passwords)
/src-tauri/keys/*.key
/src-tauri/keys/*.password

# ai workflow artifacts
swarm-blackboard.md
swarm-outputs/
skills-lock.json

# misc folders
.vs/
.cache/

# Temporary backend binary copy
rust-backend/riftwatch-backend-run.exe

rust-backend/riftwatch-backend-run.*

# Backend start logs
rust-backend/backend-start.log*
